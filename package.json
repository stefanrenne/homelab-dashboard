{
  "name": "homelab-dashboard",
  "version": "0.8.0",
  "private": true,
  "description": "A YAML-configured homelab dashboard with widgets anyone can publish outside the core",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js --config config.example --port 3000",
    "test": "node --test --test-force-exit \"tests/**/*.test.mjs\"",
    "new-widget": "node scripts/new-widget.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanrenne/homelab-dashboard.git"
  }
}
